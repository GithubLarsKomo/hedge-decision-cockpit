{
  "name": "NASDAQ Hedge Decision Cockpit",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "20 22 * * 1-5" }] }
      },
      "id": "schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": { "url": "https://query1.finance.yahoo.com/v8/finance/chart/%5ENDX?range=2y&interval=1d", "options": {} },
      "id": "ndx",
      "name": "NASDAQ 100",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, -80]
    },
    {
      "parameters": { "url": "https://query1.finance.yahoo.com/v8/finance/chart/%5EVIX?range=2y&interval=1d", "options": {} },
      "id": "vix",
      "name": "VIX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 80]
    },
    {
      "parameters": { "jsCode": "// Paste n8n/decision-engine.js here" },
      "id": "decision",
      "name": "Decision Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://DEINE-DOMAIN.de/api/decision",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer {{$env.N8N_INGEST_TOKEN}}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "post-api",
      "name": "POST to Dashboard API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 0]
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "NASDAQ 100", "type": "main", "index": 0 }, { "node": "VIX", "type": "main", "index": 0 }]] },
    "NASDAQ 100": { "main": [[{ "node": "Decision Engine", "type": "main", "index": 0 }]] },
    "VIX": { "main": [[{ "node": "Decision Engine", "type": "main", "index": 0 }]] },
    "Decision Engine": { "main": [[{ "node": "POST to Dashboard API", "type": "main", "index": 0 }]] }
  },
  "settings": { "timezone": "Europe/Berlin" }
}
