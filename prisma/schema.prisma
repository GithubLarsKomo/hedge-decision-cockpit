generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Decision {
  id                     Int      @id @default(autoincrement())
  createdAt              DateTime @default(now())
  observedAt             DateTime?
  source                  String?
  inputFingerprint        String?  @unique
  ruleVersion             String   @default("1.0.0")
  triggeredRulesJson      Json?
  ndxNow                  Float
  ndxHigh2y               Float
  ndxDrawdownPct          Float
  vixNow                  Float
  vixPercentile           Float
  action                  String
  severity                String
  recommendation          String
  portfolioMarketValueEur Decimal?
  hedgeMarketValueEur     Decimal?
  hedgeUnrealizedGainEur  Decimal?
  hedgeCoveragePercent    Decimal?
  notes                   String?
  portfolioSnapshot       PortfolioSnapshot?
  hedgePositionSnapshot   HedgePositionSnapshot?
  executionAuditRecord    ExecutionAuditRecord?

  @@index([createdAt])
  @@index([observedAt])
  @@index([action])
  @@index([severity])
}

model PortfolioSnapshot {
  id                  Int      @id @default(autoincrement())
  decisionId          Int      @unique
  createdAt           DateTime @default(now())
  marketValueEur      Decimal
  targetHedgePercent  Decimal?
  decision            Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model ImportedPortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  snapshotId       String
  revision         Int
  asOf             DateTime
  generatedAt      DateTime
  schemaVersion    String
  strategyName     String
  strategyVersion  String
  inputFingerprint String   @unique
  payloadJson      Json

  @@unique([snapshotId, revision])
  @@index([asOf])
  @@index([strategyName, strategyVersion])
}

model EtfMappingArtifact {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  mappingVersion     String
  effectiveDate      DateTime
  mappingFingerprint String   @unique
  schemaVersion      String
  payloadJson        Json

  @@index([effectiveDate, createdAt])
  @@index([mappingVersion])
}

model EtfMappingReviewRecord {
  id                          Int      @id @default(autoincrement())
  createdAt                   DateTime @default(now())
  recordFingerprint           String   @unique
  schemaVersion               String
  currentMappingVersion       String
  currentMappingFingerprint   String
  candidateMappingVersion     String?
  candidateMappingFingerprint String?
  outcome                     String
  reviewer                    String
  reviewedAt                  DateTime
  rationale                   String
  payloadJson                 Json

  @@index([reviewedAt])
  @@index([currentMappingFingerprint, reviewedAt])
  @@index([outcome])
}

model MonthlyRunCompletion {
  id                       Int      @id @default(autoincrement())
  createdAt                DateTime @default(now())
  completedAt              DateTime
  completionFingerprint    String   @unique
  snapshotFingerprint      String
  decisionId               Int
  mappingReviewFingerprint String?
  actor                     String
  rationale                 String

  @@index([completedAt])
  @@index([snapshotFingerprint])
  @@index([decisionId])
}

model HedgePositionSnapshot {
  id                    Int      @id @default(autoincrement())
  decisionId            Int      @unique
  createdAt             DateTime @default(now())
  underlying            String
  instrumentDescription String?
  quantity              Decimal?
  strike                 Decimal?
  expiry                 DateTime?
  marketValueEur         Decimal?
  unrealizedGainEur      Decimal?
  decision               Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model ExecutionAuditRecord {
  id                       Int      @id @default(autoincrement())
  decisionId               Int      @unique
  recommendationId         String   @unique
  recommendedStrategy      String
  recommendedContracts     Int
  decidedAt                DateTime
  approvalDecision         String
  approvalActorId          String
  approvalRecordedAt       DateTime
  approvalReason           String?
  executionStatus          String
  executionActorId         String?
  executionRecordedAt      DateTime?
  executedStrategy         String?
  executedContracts        Int?
  averagePrice             Decimal?
  strategyChanged          Boolean
  contractQuantityChanged  Boolean
  notFullyExecuted         Boolean
  deviationReason          String?
  createdAt                DateTime @default(now())
  decision                 Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decidedAt])
  @@index([approvalDecision])
  @@index([executionStatus])
}

model MarketSnapshot {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  observedAt           DateTime
  source               String
  contentHash          String   @unique
  ndxClose             Float
  ndxReferenceHigh     Float
  ndxDrawdownPercent   Float
  vixClose             Float?
  vxnClose             Float?
  riskFreeRate         Float?
  dividendYield        Float?

  @@unique([source, observedAt])
  @@index([observedAt])
  @@index([source])
}
