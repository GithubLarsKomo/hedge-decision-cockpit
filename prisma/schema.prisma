generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Decision {
  id                     Int      @id @default(autoincrement())
  createdAt              DateTime @default(now())
  observedAt             DateTime?
  source                  String?  @db.VarChar(120)
  inputFingerprint        String?  @unique @db.VarChar(64)
  ruleVersion             String   @default("1.0.0") @db.VarChar(30)
  triggeredRulesJson      Json?
  ndxNow                  Float
  ndxHigh2y               Float
  ndxDrawdownPct          Float
  vixNow                  Float
  vixPercentile           Float
  action                  String   @db.VarChar(80)
  severity                String   @db.VarChar(20)
  recommendation          String   @db.Text
  portfolioMarketValueEur Decimal? @db.Decimal(18, 2)
  hedgeMarketValueEur     Decimal? @db.Decimal(18, 2)
  hedgeUnrealizedGainEur  Decimal? @db.Decimal(18, 2)
  hedgeCoveragePercent    Decimal? @db.Decimal(7, 2)
  notes                   String?  @db.Text
  portfolioSnapshot       PortfolioSnapshot?
  hedgePositionSnapshot   HedgePositionSnapshot?
  executionAuditRecord    ExecutionAuditRecord?

  @@index([createdAt])
  @@index([observedAt])
  @@index([action])
  @@index([severity])
}

model PortfolioSnapshot {
  id                  Int      @id @default(autoincrement())
  decisionId          Int      @unique
  createdAt           DateTime @default(now())
  marketValueEur      Decimal  @db.Decimal(18, 2)
  targetHedgePercent  Decimal? @db.Decimal(7, 2)
  decision            Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model ImportedPortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  snapshotId       String   @db.VarChar(80)
  revision         Int
  asOf             DateTime @db.Date
  generatedAt      DateTime
  schemaVersion    String   @db.VarChar(40)
  strategyName     String   @db.VarChar(120)
  strategyVersion  String   @db.VarChar(80)
  inputFingerprint String   @unique @db.VarChar(71)
  payloadJson      Json

  @@unique([snapshotId, revision])
  @@index([asOf])
  @@index([strategyName, strategyVersion])
}

model EtfMappingReviewRecord {
  id                          Int      @id @default(autoincrement())
  createdAt                   DateTime @default(now())
  recordFingerprint           String   @unique @db.VarChar(71)
  schemaVersion               String   @db.VarChar(40)
  currentMappingVersion       String   @db.VarChar(80)
  currentMappingFingerprint   String   @db.VarChar(71)
  candidateMappingVersion     String?  @db.VarChar(80)
  candidateMappingFingerprint String?  @db.VarChar(71)
  outcome                     String   @db.VarChar(32)
  reviewer                    String   @db.VarChar(160)
  reviewedAt                  DateTime
  rationale                   String   @db.Text
  payloadJson                 Json

  @@index([reviewedAt])
  @@index([currentMappingFingerprint, reviewedAt])
  @@index([outcome])
}

model HedgePositionSnapshot {
  id                    Int      @id @default(autoincrement())
  decisionId            Int      @unique
  createdAt             DateTime @default(now())
  underlying            String   @db.VarChar(40)
  instrumentDescription String?  @db.VarChar(255)
  quantity              Decimal? @db.Decimal(18, 4)
  strike                 Decimal? @db.Decimal(18, 4)
  expiry                 DateTime?
  marketValueEur         Decimal? @db.Decimal(18, 2)
  unrealizedGainEur      Decimal? @db.Decimal(18, 2)
  decision               Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model ExecutionAuditRecord {
  id                       Int      @id @default(autoincrement())
  decisionId               Int      @unique
  recommendationId         String   @unique @db.VarChar(120)
  recommendedStrategy      String   @db.VarChar(80)
  recommendedContracts     Int
  decidedAt                DateTime
  approvalDecision         String   @db.VarChar(20)
  approvalActorId          String   @db.VarChar(120)
  approvalRecordedAt       DateTime
  approvalReason           String?  @db.Text
  executionStatus          String   @db.VarChar(30)
  executionActorId         String?  @db.VarChar(120)
  executionRecordedAt      DateTime?
  executedStrategy         String?  @db.VarChar(80)
  executedContracts        Int?
  averagePrice             Decimal? @db.Decimal(18, 4)
  strategyChanged          Boolean
  contractQuantityChanged  Boolean
  notFullyExecuted         Boolean
  deviationReason          String?  @db.Text
  createdAt                DateTime @default(now())
  decision                 Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decidedAt])
  @@index([approvalDecision])
  @@index([executionStatus])
}

model MarketSnapshot {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  observedAt           DateTime
  source               String   @db.VarChar(120)
  contentHash          String   @unique @db.VarChar(64)
  ndxClose             Float
  ndxReferenceHigh     Float
  ndxDrawdownPercent   Float
  vixClose             Float?
  vxnClose             Float?
  riskFreeRate         Float?
  dividendYield        Float?

  @@unique([source, observedAt])
  @@index([observedAt])
  @@index([source])
}