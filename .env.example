# Hostinger MySQL/MariaDB connection
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME"

# Token used by n8n for POST /api/decision
N8N_INGEST_TOKEN="replace-with-a-long-random-token"

# Optional simple dashboard protection
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="replace-with-a-long-password"
