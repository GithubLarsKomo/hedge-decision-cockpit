{
  "name": "hedge-decision-cockpit-nextjs",
  "version": "1.71.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false 1>&2",
    "test": "tsx --test lib/*.test.ts",
    "test:runtime": "node scripts/runtime-smoke-test.mjs",
    "generate:audit-evidence": "tsx scripts/generate-execution-audit-evidence.ts",
    "verify:audit-evidence": "tsx scripts/verify-execution-audit-evidence.ts",
    "sign:audit-evidence": "tsx scripts/sign-execution-audit-evidence.ts",
    "verify:audit-evidence-signature": "tsx scripts/verify-execution-audit-evidence-signature.ts",
    "verify:audit-evidence-signature-registry": "tsx scripts/verify-execution-audit-evidence-signature-registry.ts",
    "validate:audit-signing-registry": "tsx scripts/validate-execution-audit-signing-key-registry.ts",
    "fingerprint:audit-signing-registry": "tsx scripts/fingerprint-execution-audit-signing-key-registry.ts",
    "verify:audit-signing-registry-fingerprint": "tsx scripts/verify-execution-audit-signing-key-registry-fingerprint.ts",
    "sign:audit-signing-registry-fingerprint": "tsx scripts/sign-execution-audit-signing-key-registry-fingerprint.ts",
    "verify:audit-signing-registry-fingerprint-signature": "tsx scripts/verify-execution-audit-signing-key-registry-fingerprint-signature.ts",
    "verify:audit-signing-registry-fingerprint-signature-registry": "tsx scripts/verify-execution-audit-signing-key-registry-fingerprint-signature-registry.ts",
