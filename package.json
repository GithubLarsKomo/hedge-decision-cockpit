    "generate:sbom-summary": "node scripts/generate-sbom-summary.mjs",
    "generate:supply-chain-index": "node scripts/generate-supply-chain-evidence-index.mjs",
    "verify:supply-chain-index": "node scripts/verify-supply-chain-evidence-index.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "seed:sample": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "chart.js": "^4.4.7",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
