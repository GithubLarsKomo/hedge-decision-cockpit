{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/portfolio-snapshot-1.0.schema.json",
  "title": "Portfolio Snapshot 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","snapshot_id","revision","as_of","generated_at","strategy","portfolio","exposures","purchase_scenarios","source_fingerprints","input_fingerprint"],
  "properties": {
    "schema_version": {"const": "portfolio-snapshot/1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","version","source_observation_date","estimation_status","confidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_observation_date": {"type": "string", "format": "date"},
        "estimation_status": {"enum": ["observed","estimated","mixed","manual"]},
        "confidence": {"enum": ["high","medium","low"]}
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency","market_value","monthly_contribution","additional_cash_available","target_equity_weight","current_equity_weight","equity_gap_amount"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "market_value": {"type": "number", "minimum": 0},
        "monthly_contribution": {"type": "number", "minimum": 0},
        "additional_cash_available": {"type": "number", "minimum": 0},
        "target_equity_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "current_equity_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "equity_gap_amount": {"type": "number"}
      }
    },
    "exposures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exposure_id","target_weight","current_weight","gap_amount","target_source","mapped_instruments","mapping_version"],
        "properties": {
          "exposure_id": {"type": "string", "minLength": 1},
          "target_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "current_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "gap_amount": {"type": "number"},
          "target_source": {"enum": ["observed","estimated","manual"]},
          "active_purchase_instrument": {"type": "string", "minLength": 1},
          "mapped_instruments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "mapping_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "purchase_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id","contribution_amount","additional_purchase_amount"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "contribution_amount": {"type": "number", "minimum": 0},
          "additional_purchase_amount": {"type": "number", "minimum": 0}
        }
      }
    },
    "source_fingerprints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "x-domain-invariants": [
    "exposure_id values are unique within a snapshot",
    "scenario_id values are unique within a snapshot",
    "active_purchase_instrument, when present, occurs in mapped_instruments",
    "input_fingerprint equals SHA-256 of the canonical payload excluding input_fingerprint"
  ]
}
