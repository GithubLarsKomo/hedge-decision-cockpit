# Copy to .env.docker and replace every CHANGE_ME value.
APP_PORT=3000

# SQLite is bind-mounted automatically at ./data/hedge.db.
# DATABASE_URL is intentionally not stored here because the Docker path and
# the direct Windows/Linux CLI path are different.

# Retained only for the one-time MariaDB -> SQLite migration profile.
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_DATABASE=hedge_decision
MARIADB_USER=hedge_user
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# API compatibility token. The automatic Docker FRED scheduler uses this token
# only to call the app's existing authenticated FRED sync endpoint internally.
N8N_INGEST_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
FRED_API_KEY=CHANGE_ME_FRED_API_KEY

# Automatic FRED market-data acquisition. Defaults are shown explicitly here.
# FRED_SYNC_TIME is interpreted in FRED_SYNC_TIMEZONE.
FRED_SYNC_TIME=22:30
FRED_SYNC_TIMEZONE=Europe/Berlin
FRED_SYNC_POLL_SECONDS=60

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_LONG_DASHBOARD_PASSWORD
